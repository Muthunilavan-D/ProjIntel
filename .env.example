# ===================================================
# PROJINTEL - Environment Configuration
# Copy this file to .env and fill in your credentials
# ===================================================

# Server Configuration
PORT=5000

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Database Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=Final_Yr_Project

# Groq Cloud AI SDK (Proposal analysis, risk assessment, feedback generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Institutional SMTP Email Delivery (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
